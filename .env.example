# Server Configuration
PORT=5000
NODE_ENV=development

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# OpenAI Configuration
# Get your key from: https://platform.openai.com/api-keys
# Cost: $0.15/1M tokens (gpt-4o-mini) or $5/1M tokens (gpt-4)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# OPTIONAL: Choose which OpenAI model to use
# Options: gpt-4 (better quality) or gpt-4o-mini (cheaper, default)
OPENAI_MODEL=gpt-4o-mini

# Apify Configuration (for scraping Booking.com data)
APIFY_API_TOKEN=your_apify_token_here

# Resend Configuration (NEW - for sending PDF reports via email)
# Get your key from: https://resend.com/api-keys
# Free tier: 3000 emails/month
RESEND_API_KEY=re_your_resend_api_key_here

# PDFShift Configuration (for generating PDF reports)
# Get your key from: https://pdfshift.io
# Free tier: 250 PDFs/month
# Default key provided (for testing only):
PDFSHIFT_API_KEY=sk_e73390e3fb607518bd835b3abf4034682e40ae01

# Application URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# ═══════════════════════════════════════════════════════════
# PREMIUM FEATURES (Optional - for higher quality reports)
# ═══════════════════════════════════════════════════════════

# LLM Council - Multi-Model AI Analysis
# Enable to use multiple AI models (GPT-4 + Claude + Gemini) for consensus analysis
# Provides higher quality reports through multi-model validation
# Cost: ~€0.08-0.12 per report (vs €0.01-0.02 for single model)
USE_LLM_COUNCIL=false

# Anthropic API (Claude Sonnet) - for LLM Council
# Get your key from: https://console.anthropic.com/
# Cost: $3/1M tokens
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Google AI API (Gemini) - for LLM Council
# Get your key from: https://ai.google.dev/
# Free tier available
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Tavily Search API - Real-time Tourism Data Research
# Searches web for real events, festivals, tourism statistics
# Leave empty to use AI model knowledge only (less accurate)
# Get your key from: https://app.tavily.com/
# Cost: $0.001 per search (very cheap)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Supabase - Location Data Caching
# Caches tourism research for 90 days to avoid repeated searches
# Saves 80% on API costs for repeated locations
# Get credentials from: https://app.supabase.com/
# Free tier: 500MB database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ═══════════════════════════════════════════════════════════
# SETUP GUIDE
# ═══════════════════════════════════════════════════════════
#
# BASIC SETUP (Minimum Required):
# 1. STRIPE_SECRET_KEY & STRIPE_PUBLISHABLE_KEY - Payment processing
# 2. OPENAI_API_KEY - AI analysis
# 3. APIFY_API_TOKEN - Property data scraping
# 4. RESEND_API_KEY - Email delivery
# 5. PDFSHIFT_API_KEY - PDF generation
#
# PREMIUM SETUP (For Best Quality Reports):
# 1. All BASIC keys above
# 2. Set USE_LLM_COUNCIL=true
# 3. Add ANTHROPIC_API_KEY and/or GOOGLE_AI_API_KEY
# 4. Add TAVILY_API_KEY for real tourism data
# 5. Add SUPABASE_URL and SUPABASE_KEY for caching
#
# COST COMPARISON (per €10 report):
# - Basic (gpt-4o-mini): ~€0.01-0.02 profit margin: 99.8%
# - Premium (Council + Tavily): ~€0.08-0.12 profit margin: 98.8%
# - With caching: 80% cost reduction on repeated locations
#
# ═══════════════════════════════════════════════════════════
# DEPRECATED (No longer needed)
# ═══════════════════════════════════════════════════════════
# EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASSWORD - Replaced by RESEND_API_KEY
